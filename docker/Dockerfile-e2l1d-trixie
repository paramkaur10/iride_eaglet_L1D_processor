# Eaglet-2 L1C to L1D processor (EAGLET2_L1D_PROC 01.02) for the IRIDE PDGS, in the format of the PDGS
# build of the previous version (Dockerfile-e2cp-trixie, image ipf-ime-msi-l1cc:01.00): the same
# production base image, user, virtual environment and folders. Build context (docker/build_image.sh
# makes it in dist/build/ from the repository):
#   iride_eaglet_processor_v2-main.zip     the repository as a zip (its name sets the folder in the image)
#   Eaglet-2-L1D-requirements-trixie.txt   the Python packages (docker/ in the repository)
#   clarity_eaglet2_fp32/                  the cloud model package (Clarity), as delivered, with its SHA256SUMS
# The cloud model package goes to models/clarity_eaglet2_fp32 of the repository, where the processor
# reads it, and is checked against its SHA256SUMS here. PDGS runs the image as
#   docker run --user 1100:600 ... -v <WD>:<WD>:rw -w <WD> ipf-ime-msi-l1d:01.02 EAGLET2_L1D <WD>/JobOrder.<id>.xml

#production base image bc5c1e7a2ec7
# Pinned to the copy of python:3.14.8-slim-trixie that 01.01 was built on (the build of 6 Oct 2026,
# linux/amd64, image ID cbe8543d6805): later copies under the same tag carry newer Debian packages.
FROM python:3.14.8-slim-trixie@sha256:cfe2e24a75302a15934d37c2d86412893c0aa934dc3a97cbb439d04c01890ca9

RUN apt-get update
RUN apt-get install -y --no-install-recommends unzip libexpat1
RUN groupadd -g 600 iride && useradd  -g iride -u 1100 -m -d /opt/ipf-ime-msi-l1d opiride
# the entry point (the task name): EAGLET2_L1D <Job Order> runs process_l1c.py
RUN ln -s /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main/process_l1c.py /usr/local/bin/EAGLET2_L1D
USER 1100:600
RUN mkdir -p /opt/ipf-ime-msi-l1d/Eaglet2VEnv /opt/ipf-ime-msi-l1d/workdir
ADD iride_eaglet_processor_v2-main.zip /opt/ipf-ime-msi-l1d/
RUN cd /opt/ipf-ime-msi-l1d/ && unzip iride_eaglet_processor_v2-main.zip && rm iride_eaglet_processor_v2-main.zip
ADD Eaglet-2-L1D-requirements-trixie.txt /opt/ipf-ime-msi-l1d/
RUN python -m venv /opt/ipf-ime-msi-l1d/Eaglet2VEnv &&  /opt/ipf-ime-msi-l1d/Eaglet2VEnv/bin/pip install --upgrade pip && /opt/ipf-ime-msi-l1d/Eaglet2VEnv/bin/pip install -r  /opt/ipf-ime-msi-l1d/Eaglet-2-L1D-requirements-trixie.txt  --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu
RUN sed -i "1s|.*|#!/opt/ipf-ime-msi-l1d/Eaglet2VEnv/bin/python3|" /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main/process_l1c.py && chmod 755 /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main/process_l1c.py
# the cloud model package, as delivered, where the processor reads it; checked against its own SHA256SUMS
COPY --chown=1100:600 clarity_eaglet2_fp32/ /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main/models/clarity_eaglet2_fp32/
RUN cd /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main/models/clarity_eaglet2_fp32 && sha256sum -c SHA256SUMS
ENV PATH=/opt/ipf-ime-msi-l1d/Eaglet2VEnv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1
RUN python -m compileall -q /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main
WORKDIR /opt/ipf-ime-msi-l1d/workdir

# Check, as user 1100 and offline: the processor imports, the cloud model package is the delivered one (its
# SHA256SUMS), and the model runs on both of its grids on a small scene (temporary files in a folder removed
# afterwards)
RUN cd /opt/ipf-ime-msi-l1d/iride_eaglet_processor_v2-main && mkdir -p /opt/ipf-ime-msi-l1d/workdir/check \
 && TMPDIR=/opt/ipf-ime-msi-l1d/workdir/check python -c "\
import sys; sys.path.insert(0, 'src'); \
import numpy as np, process_l1c; \
from iride_eaglet_processor.inference import CloudModel; \
model = CloudModel(); print('cloud model:', model.describe()); \
probs, nothing = model.probabilities(np.full((3, 300, 300), 0.1, 'float32')); \
assert probs.shape == (4, 300, 300) and not nothing.any() and np.allclose(probs.sum(0), 1, atol=1e-4); \
print('the processor imports and its cloud model runs offline, as user 1100')" \
 && rm -rf /opt/ipf-ime-msi-l1d/workdir/check
