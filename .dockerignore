# Build context of the Docker image: only what the Dockerfile copies. Keeps test_wd/ and other
# large local files out of the build.
*
!Dockerfile
!process_l1c.py
!job_order.py
!pdgs_logger.py
!product_naming.py
!task_table.xml
!src
!aux
!hf_cache
!docker
**/__pycache__
**/*.pyc
**/.ipynb_checkpoints
