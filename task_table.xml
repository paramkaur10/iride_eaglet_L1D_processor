<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task Table for the Eaglet-2 L1C -> L1D processor: cloud masking and colour
  correction (the L1D image is the colour-corrected RGB; the colour AUX file
  is built into the processor, and an AXE1D_CLUT input overrides it).

  Follows PDGS-ID-XPR-IRIDE-0209 (IRIDE Processor ICD Implementation Driver
  v2.4), Section 3.1.1 and the worked example in Section 4.1.1, and validates
  against its Task Table XSD (Appendix H). Values still to be confirmed with
  PDGS integration are marked "TODO".
-->
<Ipf_Task_Table xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="taskTable.xsd">
  <!-- Named after the OUTPUT level (L1D), per PDGS's own convention: see the
       HAWK_L1B_PROC example in Section 4.1.1, named after its output (L1B)
       despite consuming L0 input. No "CLM" in the names: the processor does
       the whole L1C to L1D step, cloud mask and colour correction (Enrico,
       12 Oct 2026). The Version is also written in the STAC of the product
       (processing:software) and is the tag of the Docker image. -->
  <Processor_Name>EAGLET2_L1D_PROC</Processor_Name>
  <Version>01.00</Version>
  <!-- Largest L1C RGB3 product observed so far is ~1.3GB. The product is
       held unzipped, renamed and re-zipped; the L1D image is first written
       as a plain GeoTIFF (uint16, 3 bands), then as the COG that replaces
       the L1C image. TODO: measure on the largest product and tighten -->
  <Min_Disk_Space units="MB">8192</Min_Disk_Space>
  <!-- CPU-only full-scene inference measured ~5 minutes on a real product;
       the colour step adds a full-resolution pass and the COG writing.
       The processor logs the time of each step ("Processing times").
       TODO: measure on the largest product and tighten -->
  <Processing_Timeout units="sec">3600</Processing_Timeout>
  <!-- The cross-IPF dynamic parameters that are mandatory in every Task
       Table (Section 3.1.2.6, Table 3-4), with the defaults given there.
       PDGS sets them in the Job Order at run time. The processor does not
       use them yet: the L1D product name keeps the environment (O) and the
       baseline (A00) of the L1C. -->
  <List_of_Dyn_ProcParams count="6">
    <Dyn_ProcParam>
      <Param_Name>Class_ID</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default>TEST</Param_Default>
    </Dyn_ProcParam>
    <Dyn_ProcParam>
      <Param_Name>Timeliness_Key</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default></Param_Default>
    </Dyn_ProcParam>
    <Dyn_ProcParam>
      <Param_Name>Environment</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default>O</Param_Default>
    </Dyn_ProcParam>
    <Dyn_ProcParam>
      <Param_Name>Processing_Baseline_1DSP__RGB3</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default>A00</Param_Default>
    </Dyn_ProcParam>
    <Dyn_ProcParam>
      <Param_Name>Acquisition_ID</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default></Param_Default>
    </Dyn_ProcParam>
    <Dyn_ProcParam>
      <Param_Name>Acquisition_Type</Param_Name>
      <Param_Type>String</Param_Type>
      <Param_Default>NOM</Param_Default>
    </Dyn_ProcParam>
  </List_of_Dyn_ProcParams>
  <List_of_Pools count="1">
    <Pool>
      <Detached>false</Detached>
      <List_of_Tasks count="1">
        <Task>
          <Name>EAGLET2_L1D</Name>
          <Version>01.00</Version>
          <Killing_Signal>2</Killing_Signal>
          <Critical>true</Critical>
          <Criticality_Level>1</Criticality_Level>
          <!-- The absolute path of PDGS's wrapper script, which runs the
               Docker image with the entry point EAGLET2_L1D and the Job
               Order (Appendix E). PDGS integration fills in the final path
               (Appendix F); this is the pattern of Appendix E, item 2.
               TODO: agree the script name and the constellation folder -->
          <Executable_File_Name>/opt/iride/iride-pdgs-ipf-prom-ttsc/ime/scripts/eaglet2-l1d-processor</Executable_File_Name>
          <List_of_Cfg_Files count="0">
          </List_of_Cfg_Files>
          <List_of_Inputs count="2">
            <Input>
              <Mode>ALWAYS</Mode>
              <Mandatory>Yes</Mandatory>
              <List_of_Alternatives count="1">
                <Alternative>
                  <Order>1</Order>
                  <Origin>External</Origin>
                  <Retrieval_Mode>LatestValidityClosest</Retrieval_Mode>
                  <T0>0</T0>
                  <T1>0</T1>
                  <!-- TODO: confirm the registered File_Type code for
                       Eaglet-2 L1C RGB3 products with PDGS/[RD_GSNCD] -->
                  <File_Type>1CSP__RGB3</File_Type>
                  <File_Name_Type>Physical</File_Name_Type>
                </Alternative>
              </List_of_Alternatives>
            </Input>
            <!-- Colour-correction AUX file (IME___AXE1D_CLUT_<validity start>_
                 <validity stop>_<creation>____________O_001.xml): the LUT,
                 Enrico's class model and the <Method> that selects one.
                 Optional: the processor carries its own in aux/ and uses it
                 by default; a file given here overrides it.
                 TODO: confirm with PDGS integration the File_Type code,
                 Origin and Retrieval_Mode for auxiliary files -->
            <Input>
              <Mode>ALWAYS</Mode>
              <Mandatory>No</Mandatory>
              <List_of_Alternatives count="1">
                <Alternative>
                  <Order>1</Order>
                  <Origin>External</Origin>
                  <Retrieval_Mode>LatestValCover</Retrieval_Mode>
                  <T0>0</T0>
                  <T1>0</T1>
                  <File_Type>AXE1D_CLUT</File_Type>
                  <File_Name_Type>Physical</File_Name_Type>
                </Alternative>
              </List_of_Alternatives>
            </Input>
          </List_of_Inputs>
          <List_of_Outputs count="1">
            <Output>
              <!-- New L1D product, a genuinely separate file from the
                   input (per Enrico/Paola's confirmed naming convention:
                   "1CSP" -> "1DSP", generation timestamp updated to this
                   run's processing time). The input product is untouched. -->
              <Destination>External</Destination>
              <Mandatory>Yes</Mandatory>
              <File_Name_Type>Physical</File_Name_Type>
              <!-- TODO: confirm the registered File_Type code for this
                   new L1D product with PDGS/[RD_GSNCD] -->
              <File_Type>1DSP__RGB3</File_Type>
              <File_Name>./</File_Name>
              <Reg_Exp>^IME[0-9]{2}_1DSP__RGB3.*\.zip$</Reg_Exp>
            </Output>
          </List_of_Outputs>
          <Breakpoint>
            <Enable>OFF</Enable>
            <List_of_Brk_Files count="0"/>
          </Breakpoint>
          <!-- The processor sizes its thread pools (PyTorch, NumPy's maths
               libraries) to this number, NUMBER_OF_CPUS in process_l1c.py,
               on any machine (Section 2.1). The colour correction runs on
               one core. -->
          <Number_of_CPUs>2</Number_of_CPUs>
          <Posix_ExitCode>false</Posix_ExitCode>
        </Task>
      </List_of_Tasks>
    </Pool>
  </List_of_Pools>
</Ipf_Task_Table>
